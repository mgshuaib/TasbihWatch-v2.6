tests/node_modules/
tests/package-lock.json
node_modules/

# ── مفاتيح وتوقيع (لا تُرفع أبدًا) ──
private_keys/
*.p8
*.p12
*.mobileprovision
*.keychain

# ── نظام ──
.DS_Store
*.swp
__pycache__/
