# Fastfile — رفع حزمة IPA إلى TestFlight بدون Xcode
# يعتمد على مفاتيح App Store Connect API (لا يطلب كلمة مرور ولا رمز تحقق ثنائي)

default_platform(:ios)

platform :ios do

  desc "رفع النسخة المبنية في السيرفر إلى TestFlight"
  lane :upload do

    ipa_path = ENV["IPA_PATH"]
    ipa_path = Dir["../build/export/*.ipa"].first if ipa_path.to_s.empty?
    UI.user_error!("لم أجد ملف IPA — تحقق من خطوة التصدير") if ipa_path.nil?

    api_key = app_store_connect_api_key(
      key_id:        ENV["ASC_KEY_ID"],
      issuer_id:     ENV["ASC_ISSUER_ID"],
      key_filepath:  ENV["ASC_KEY_PATH"],
      duration:      1200,
      in_house:      false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,  # لا ننتظر معالجة أبل (تستغرق دقائق)
      skip_submission: true                     # للمختبِرين الداخليين فقط، بلا مراجعة
    )

    UI.success("تم الرفع ✅ — افتح TestFlight على الآيفون بعد 5–15 دقيقة")
  end
end
